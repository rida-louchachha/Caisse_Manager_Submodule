<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================
         WHATSAPP CONVERSATION KANBAN VIEW
         Clean and simple WhatsApp-style sidebar
         ============================================ -->
    <record id="view_whatsapp_conversation_kanban" model="ir.ui.view">
        <field name="name">whatsapp.conversation.kanban</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <kanban class="o_whatsapp_conversation_kanban" sample="1">
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="last_message"/>
                <field name="last_message_date"/>
                <field name="unread_count"/>
                <templates>
                    <t t-name="card" class="p-0 border-0 mb-0">
                        <div class="d-flex align-items-center p-3" 
                             style="background: #202c33; border-bottom: 1px solid #2a3942; cursor: pointer;">
                            <!-- Avatar -->
                            <div class="rounded-circle me-3 d-flex align-items-center justify-content-center flex-shrink-0" 
                                 style="width: 48px; height: 48px; background: linear-gradient(135deg, #00a884 0%, #00d4aa 100%); color: white; font-weight: 600; font-size: 20px;">
                                👤
                            </div>
                            
                            <!-- Conversation Info -->
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <strong class="text-truncate" style="color: #e9edef; font-size: 16px;">
                                        <field name="partner_id"/>
                                    </strong>
                                    <small style="color: #8696a0; font-size: 12px;">
                                        <field name="last_message_date" widget="relative"/>
                                    </small>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-truncate" style="color: #8696a0; font-size: 14px; max-width: 180px;">
                                        <field name="last_message"/>
                                    </span>
                                    <t t-if="record.unread_count.raw_value > 0">
                                        <span class="badge rounded-pill" style="background: #00a884; color: white; font-size: 11px;">
                                            <field name="unread_count"/>
                                        </span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================
         WHATSAPP CONVERSATION FORM VIEW
         ============================================ -->
    <record id="view_whatsapp_conversation_form" model="ir.ui.view">
        <field name="name">whatsapp.conversation.form</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Chat">
                <sheet style="background: #111b21;">
                    <!-- Chat Header -->
                    <div class="d-flex align-items-center p-3 mb-3" style="background: #202c33; border-radius: 8px;">
                        <div class="rounded-circle me-3 d-flex align-items-center justify-content-center"
                             style="width: 45px; height: 45px; background: linear-gradient(135deg, #00a884, #00d4aa); color: white;">
                            <span style="font-size: 18px;">👤</span>
                        </div>
                        <div class="flex-grow-1">
                            <h4 class="mb-0" style="color: #e9edef;"><field name="partner_id" readonly="1" nolabel="1"/></h4>
                            <small style="color: #8696a0;"><field name="phone" readonly="1" nolabel="1"/></small>
                        </div>
                        <button name="action_mark_as_read" type="object" 
                                class="btn btn-sm" style="background: #00a884; color: white; border: none;">
                            ✓ Mark Read
                        </button>
                    </div>
                    
                    <!-- Messages -->
                    <group string="💬 Messages">
                        <field name="message_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="create_date" string="Date"/>
                                <field name="direction" string="→" widget="badge"
                                       decoration-success="direction == 'outgoing'"
                                       decoration-info="direction == 'incoming'"/>
                                <field name="message" string="Message"/>
                                <field name="status" widget="badge"
                                       decoration-success="status in ('sent', 'delivered', 'read', 'received')"
                                       decoration-danger="status == 'failed'"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================
         CONVERSATION LIST VIEW
         ============================================ -->
    <record id="view_whatsapp_conversation_list" model="ir.ui.view">
        <field name="name">whatsapp.conversation.list</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <list string="Conversations" sample="1">
                <field name="partner_id" string="👤 Contact"/>
                <field name="phone" string="📞 Phone"/>
                <field name="last_message" string="💬 Last Message"/>
                <field name="last_message_date" string="🕐 Time" widget="relative"/>
                <field name="unread_count" string="📬 Unread"/>
            </list>
        </field>
    </record>

    <!-- ============================================
         SEARCH VIEW
         ============================================ -->
    <record id="view_whatsapp_conversation_search" model="ir.ui.view">
        <field name="name">whatsapp.conversation.search</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <search string="Search Conversations">
                <field name="partner_id"/>
                <field name="phone"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Contact" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================
         CLIENT ACTION FOR CUSTOM CHAT VIEW
         ============================================ -->
    <record id="action_whatsapp_chat_client" model="ir.actions.client">
        <field name="name">💬 WhatsApp Chat</field>
        <field name="tag">whatsapp_chat_client_action</field>
    </record>

    <!-- Standard window action (fallback) -->
    <record id="action_whatsapp_chat" model="ir.actions.act_window">
        <field name="name">💬 Conversations (List)</field>
        <field name="res_model">whatsapp.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_whatsapp_conversation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No conversations yet!
            </p>
            <p>
                Start sending WhatsApp messages from your subscriptions.
            </p>
        </field>
    </record>

    <!-- ============================================
         MENU ITEMS
         ============================================ -->
    <menuitem id="menu_whatsapp_conversations"
              name="💬 WhatsApp Chat"
              parent="menu_whatsapp_inbox_root"
              action="action_whatsapp_chat_client"
              sequence="5"/>
    
    <menuitem id="menu_whatsapp_conversations_list"
              name="📋 Conversations List"
              parent="menu_whatsapp_inbox_root"
              action="action_whatsapp_chat"
              sequence="6"/>

</odoo>

