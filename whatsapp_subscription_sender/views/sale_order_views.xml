<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action to send WhatsApp from list (multi-select) -->
    <record id="action_send_whatsapp_subscription" model="ir.actions.act_window">
        <field name="name">Send WhatsApp Message</field>
        <field name="res_model">whatsapp.subscription.sender</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- Inherit Form View to add Smart Buttons and WhatsApp Tab -->
    <record id="sale_order_view_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.whatsapp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Smart Buttons -->
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_whatsapp_logs" icon="fa-whatsapp">
                    <field name="whatsapp_message_count" widget="statinfo" string="Messages"/>
                </button>
            </div>
            
            <!-- Header Buttons -->
            <xpath expr="//form//header" position="inside">
                <button name="action_send_whatsapp_template" 
                        string="📱 Send WhatsApp" 
                        type="object" 
                        class="btn-success"
                        invisible="state not in ('sale', 'done')"/>
                <button name="action_open_whatsapp_chat" 
                        string="💬 Open Chat" 
                        type="object" 
                        class="btn-primary"
                        invisible="state not in ('sale', 'done')"/>
            </xpath>
            
            <!-- WhatsApp Chat Panel (replaces simple log list) -->
            <xpath expr="//notebook" position="inside">
                <page string="💬 WhatsApp Chat" name="whatsapp_chat">
                    <div class="row">
                        <!-- Left side: Status and Quick Actions -->
                        <div class="col-md-4">
                            <group string="📊 Status">
                                <field name="whatsapp_status" widget="badge"
                                       decoration-success="whatsapp_status in ('sent', 'delivered', 'read')"
                                       decoration-danger="whatsapp_status == 'failed'"
                                       decoration-muted="whatsapp_status == 'not_sent'"/>
                                <field name="last_whatsapp_date"/>
                            </group>
                            <group string="⚡ Quick Actions">
                                <button name="action_send_whatsapp_template" 
                                        string="📋 Send Template" 
                                        type="object" 
                                        class="btn-success w-100 mb-2"/>
                                <button name="action_open_whatsapp_chat" 
                                        string="🔗 Full Chat View" 
                                        type="object" 
                                        class="btn-outline-primary w-100"/>
                            </group>
                        </div>
                        
                        <!-- Right side: Chat Widget -->
                        <div class="col-md-8">
                            <!-- Using a container for the widget -->
                            <div class="whatsapp-chat-container" style="min-height: 400px;">
                                <field name="partner_id" widget="whatsapp_chat_widget" nolabel="1"/>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Message History Table (collapsible) -->
                    <details class="mt-4">
                        <summary style="cursor: pointer; color: #666; font-weight: 500;">
                            📜 Message History (click to expand)
                        </summary>
                        <field name="whatsapp_log_ids" nolabel="1" class="mt-2">
                            <list create="false" delete="false" edit="false"
                                  decoration-success="direction == 'outgoing' and status in ('sent', 'delivered', 'read')"
                                  decoration-info="direction == 'incoming'"
                                  decoration-danger="status == 'failed'">
                                <field name="create_date" string="📅 Date"/>
                                <field name="direction" string="↔️"/>
                                <field name="message" string="💬 Message"/>
                                <field name="phone" string="📞 Phone"/>
                                <field name="status" widget="badge"
                                       decoration-success="status in ('sent', 'delivered', 'read', 'received')"
                                       decoration-danger="status == 'failed'"/>
                            </list>
                        </field>
                    </details>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherit List View to add WhatsApp Status -->
    <record id="sale_order_view_list_inherit_whatsapp" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.whatsapp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="whatsapp_status" widget="badge" 
                       decoration-success="whatsapp_status in ('sent', 'delivered', 'read')"
                       decoration-info="whatsapp_status == 'not_sent'"
                       decoration-danger="whatsapp_status == 'failed'"
                       optional="show"/>
                <field name="last_whatsapp_date" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
