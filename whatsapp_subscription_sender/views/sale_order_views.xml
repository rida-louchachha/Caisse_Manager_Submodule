<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_send_whatsapp_subscription" model="ir.actions.act_window">
        <field name="name">Send WhatsApp Message</field>
        <field name="res_model">whatsapp.subscription.sender</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- Inherit Form View to add Smart Button -->
    <record id="sale_order_view_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.whatsapp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_whatsapp_logs" icon="fa-whatsapp">
                    <div class="o_stat_info">
                        <span class="o_stat_text">WhatsApp</span>
                        <span class="o_stat_text">Logs</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

    <!-- Inherit List View to add Last WhatsApp Date -->
    <record id="sale_order_view_list_inherit_whatsapp" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.whatsapp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="whatsapp_status" widget="badge" 
                       decoration-success="whatsapp_status == 'sent'"
                       decoration-danger="whatsapp_status == 'failed'"
                       decoration-muted="whatsapp_status == 'not_sent'"
                       optional="show"/>
                <field name="last_whatsapp_date" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
