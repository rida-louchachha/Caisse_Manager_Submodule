<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
        Menu Action: Refresh All Subscriptions (accessible without selection)
    -->
    <record id="action_refresh_all_menu" model="ir.actions.server">
        <field name="name">🔄 Refresh All &amp; Show Summary</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">action = env['sale.order'].action_refresh_all_subscriptions()</field>
    </record>
    
    <!-- Menu items under Subscriptions menu -->
    <menuitem id="menu_subscription_refresh" 
              name="🔄 Refresh All Subscriptions"
              action="action_refresh_all_menu"
              parent="sale_subscription.menu_sale_subscription"
              sequence="100"/>
    
    <!-- 
        Extend the subscription-specific list view with payment tracking
        This is the view used in Abonnements menu
    -->
    <record id="sale_order_view_list_inherit_cm_subscription" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.cm.subscription.main</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_view_tree"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <!-- Replace entire list content to control exact field order -->
            <xpath expr="//list" position="replace">
                <list string="Subscriptions" multi_edit="1" sample="1"
                      decoration-muted="subscription_state in ('6_churn', '5_renewed')"
                      decoration-info="subscription_state == '2_renewal'"
                      decoration-warning="subscription_state == '4_paused'"
                      default_order="next_invoice_date asc">
                    
                    <!-- Header with Refresh Button -->
                    <header>
                        <button name="action_refresh_all_button" 
                                type="object" 
                                string="🔄 Refresh All Alerts"
                                class="btn-primary"/>
                    </header>
                    
                    <!-- ========== FIELDS SHOWN BY DEFAULT (in order) ========== -->
                    
                    <!-- 1. Customer (partner_id) -->
                    <field name="partner_id" optional="show"/>
                    
                    <!-- 2. City (city_ma_id from ma_regional_access) -->
                    <field name="city_ma_id" string="City" optional="show"/>
                    
                    <!-- Optional: Region (appears after City when enabled) -->
                    <field name="region_id" string="Region" optional="hide"/>
                    
                    <!-- Optional: Phone (appears after Region when enabled) -->
                    <field name="client_phone" string="Phone" optional="hide"/>
                    
                    <!-- 3. Payment Status -->
                    <field name="subscription_payment_status" 
                           string="Payment Status" 
                           widget="badge"
                           decoration-success="subscription_payment_status in ('paid', 'in_payment', 'free')"
                           decoration-warning="subscription_payment_status in ('requires_payment', 'pending', 'should_invoice')"
                           decoration-danger="subscription_payment_status == 'expired'"
                           optional="show"/>
                    
                    <!-- 4. Total Paid -->
                    <field name="total_paid_amount" string="Total Paid" optional="show" sum="Total Paid"/>
                    
                    <!-- 5. Amount To Pay -->
                    <field name="amount_to_pay" string="Amount To Pay" optional="show" sum="Total To Pay"/>
                    
                    <!-- 6. Last Invoice Date -->
                    <field name="last_payment_date" string="Last Invoice Date" optional="show"/>
                    
                    <!-- 7. Next Invoice Date -->
                    <field name="next_invoice_date" string="Next Invoice" optional="show"/>
                    
                    <!-- 8. System Versions (from ma_regional_access) -->
                    <field name="system_version_ids" 
                           string="System Versions" 
                           widget="many2many_tags"
                           options="{'color_field': 'color'}"
                           optional="show"/>
                    
                    <!-- 9. ========== OPTIONAL HIDDEN FIELDS (will appear before Alerts when enabled) ========== -->
                    
                    <!-- name (Order Reference) -->
                    <field name="name" optional="hide" readonly="1"/>
                    
                    <!-- user_id (Salesperson) -->
                    <field name="user_id" optional="hide" widget="many2one_avatar_user"/>
                    
                    <!-- recurring_monthly (Monetary) -->
                    <field name="recurring_monthly" string="Recurring" optional="hide"/>
                    
                    <!-- plan_id -->
                    <field name="plan_id" optional="hide"/>
                    
                    <!-- company_id -->
                    <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                    
                    <!-- activity_ids -->
                    <field name="activity_ids" widget="list_activity" optional="hide"/>
                    
                    <!-- subscription_state (Subscription Status) -->
                    <field name="subscription_state" 
                           string="Status" 
                           widget="badge"
                           decoration-success="subscription_state == '3_progress'"
                           decoration-info="subscription_state == '2_renewal'"
                           decoration-warning="subscription_state == '4_paused'"
                           decoration-muted="subscription_state in ('5_renewed', '6_churn')"
                           optional="hide"/>
                    
                    <!-- Last Amount -->
                    <field name="last_payment_amount" string="Last Amount" optional="hide"/>
                    
                    <!-- Total Invoiced -->
                    <field name="total_invoiced_amount" string="Total Invoiced" optional="hide" sum="Total Invoiced"/>
                    
                    <!-- Server Shutdown Toggle (restricted field) -->
                    <field name="is_server_shutdown" 
                           string="Shutdown?"
                           widget="boolean_toggle"
                           readonly="field_readonly_is_server_shutdown"
                           optional="hide"/>
                    
                    <!-- 10. ========== ALERTS (always near end) ========== -->
                    <field name="payment_alert_message" 
                           string="Alerts" 
                           readonly="field_readonly_payment_alert_message"
                           optional="show"/>
                    
                    <!-- 11. Client Validated (restricted field) -->
                    <field name="client_info_validated" 
                           string="Client Validated"
                           widget="selection"
                           readonly="field_readonly_client_info_validated"
                           optional="show"/>
                    
                    <!-- ========== FREE SUBSCRIPTION FIELDS (after Client Validated, restricted) ========== -->
                    
                    <!-- Free Subscription Toggle (restricted field) -->
                    <field name="is_free_subscription" 
                           string="🎁 Free"
                           widget="boolean_toggle"
                           readonly="field_readonly_is_free_subscription"
                           optional="hide"/>
                    
                    <!-- Free Subscription Reason (restricted field) -->
                    <field name="free_subscription_reason" 
                           string="Free Reason"
                           widget="badge"
                           decoration-info="free_subscription_reason in ('influencer', 'partner', 'vip')"
                           decoration-success="free_subscription_reason == 'promo'"
                           decoration-muted="free_subscription_reason in ('test', 'other')"
                           readonly="field_readonly_free_subscription_reason"
                           optional="hide"/>
                    
                    <!-- Free Until Date (restricted field) -->
                    <field name="free_subscription_expiry" 
                           string="Free Until"
                           readonly="field_readonly_free_subscription_expiry"
                           optional="hide"/>
                    
                    <!-- Free Days Remaining -->
                    <field name="free_days_remaining" 
                           string="Free Days Left"
                           decoration-danger="free_days_remaining &lt;= 7 and free_days_remaining &gt; 0"
                           decoration-warning="free_days_remaining &lt;= 30 and free_days_remaining &gt; 7"
                           optional="hide"/>
                    
                    <!-- ========== INVISIBLE FIELDS FOR LOGIC ========== -->
                    <field name="has_pending_invoice" column_invisible="1"/>
                    <field name="has_missing_invoice" column_invisible="1"/>
                    <field name="is_payment_window_active" column_invisible="1"/>
                    <field name="invoice_created_for_period" column_invisible="1"/>
                    <field name="is_cm_subscription" column_invisible="1"/>
                    <field name="payment_info_tooltip" column_invisible="1"/>
                    <field name="free_subscription_expired" column_invisible="1"/>
                    <field name="state" column_invisible="1"/>
                    <field name="pricelist_id" column_invisible="1"/>
                    <field name="currency_id" column_invisible="1"/>
                    
                    <!-- Field Access Control (invisible) -->
                    <field name="field_readonly_is_server_shutdown" column_invisible="1"/>
                    <field name="field_readonly_client_info_validated" column_invisible="1"/>
                    <field name="field_readonly_is_free_subscription" column_invisible="1"/>
                    <field name="field_readonly_free_subscription_reason" column_invisible="1"/>
                    <field name="field_readonly_free_subscription_expiry" column_invisible="1"/>
                    <field name="field_readonly_payment_alert_message" column_invisible="1"/>
                </list>
            </xpath>
        </field>
    </record>


    <!-- Also extend the base sale.view_order_tree for non-subscription orders -->
    <record id="sale_order_view_list_inherit_cm_base" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.cm.base</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <!-- Add hidden fields for status logic -->
            <xpath expr="//list" position="inside">
                <field name="has_pending_invoice" column_invisible="1"/>
                <field name="has_missing_invoice" column_invisible="1"/>
                <field name="is_payment_window_active" column_invisible="1"/>
                <field name="invoice_created_for_period" column_invisible="1"/>
                <field name="is_cm_subscription" column_invisible="1"/>
                <field name="subscription_payment_status" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Extend the sale.order form view with Payment Tracking tab -->
    <record id="sale_order_view_form_inherit_cm" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.cm.subscription</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Add payment tracking tab to notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Payment Tracking" name="payment_tracking" invisible="not is_cm_subscription">
                    <!-- Status Banner -->
                    <div class="alert alert-success" role="alert" invisible="subscription_payment_status != 'paid'">
                        <strong>✅ PAID</strong> - Invoice for next month is paid.
                    </div>
                    <div class="alert alert-success" role="alert" invisible="subscription_payment_status != 'in_payment'">
                        <strong>🔵 IN PAYMENT</strong> - Payment in progress for next month.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="subscription_payment_status != 'requires_payment'">
                        <strong>⚠️ REQUIRES PAYMENT</strong> - Payment window open (1st-5th). Pay before the 5th!
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="subscription_payment_status != 'pending'">
                        <strong>🟠 PENDING PAYMENT</strong> - Invoice created for next month, awaiting payment.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="subscription_payment_status != 'expired'">
                        <strong>🔴 EXPIRED</strong> - No invoice created for next month! Create and pay to activate.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="subscription_payment_status != 'should_invoice'">
                        <strong>📝 SHOULD INVOICE</strong> - Invoice should be created for this period.
                    </div>
                    
                    <group>
                        <group string="Current Payment Status">
                            <field name="subscription_payment_status" widget="badge"/>
                            <field name="is_payment_window_active" readonly="1"/>
                            <field name="invoice_created_for_period" readonly="1"/>
                            <field name="amount_to_pay"/>
                            <field name="client_phone" readonly="1"/>
                        </group>
                        <group string="Last Payment Information">
                            <field name="last_payment_date"/>
                            <field name="last_payment_partner_id"/>
                            <field name="last_payment_amount"/>
                        </group>
                    </group>
                    <group>
                        <group string="Invoice History">
                            <field name="first_invoice_date" readonly="1"/>
                            <field name="total_invoiced_amount" readonly="1"/>
                            <field name="has_pending_invoice" readonly="1"/>
                            <field name="has_missing_invoice" readonly="1"/>
                        </group>
                        <group string="Next Invoice">
                            <field name="days_until_next_invoice" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="Payment Info Summary">
                        <field name="payment_info_tooltip" readonly="1" nolabel="1" colspan="2" widget="text"/>
                    </group>
                    
                    <!-- ===== FREE SUBSCRIPTION SECTION ===== -->
                    <group string="🎁 Free Subscription Settings">
                        <group>
                            <field name="is_free_subscription" widget="boolean_toggle"/>
                            <field name="free_subscription_reason" invisible="not is_free_subscription"/>
                        </group>
                        <group>
                            <field name="free_subscription_expiry" invisible="not is_free_subscription"/>
                            <field name="free_days_remaining" readonly="1" invisible="not is_free_subscription or not free_subscription_expiry"/>
                        </group>
                    </group>
                    <field name="free_subscription_note" invisible="not is_free_subscription" 
                           placeholder="Notes about this free subscription (e.g., influencer name, campaign, conditions...)"/>
                    
                    <!-- Alert for expired free period -->
                    <div class="alert alert-warning" role="alert" invisible="not free_subscription_expired">
                        <strong>⚡ FREE PERIOD ENDED</strong> - This subscription's free period has expired. Convert to a paid subscription or extend the free period.
                    </div>
                    
                    <!-- Button to view pending invoices -->
                    <div>
                        <button name="action_view_pending_invoices" 
                                type="object" 
                                string="View Pending Invoices"
                                class="btn-primary"
                                invisible="not has_pending_invoice"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Add search filters for subscription payment status -->
    <record id="sale_order_view_search_inherit_cm" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.cm.subscription</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <!-- ===== SEARCHABLE FIELDS FOR CUSTOM FILTER ===== -->
                <!-- These fields will appear in the "Select a field" dropdown -->
                <field name="alert_text" string="Alerts"/>
                <field name="subscription_payment_status" string="Payment Status"/>
                <field name="is_free_subscription" string="Is Free Subscription"/>
                <field name="free_subscription_reason" string="Free Reason"/>
                <field name="is_server_shutdown" string="Server Shutdown"/>
                <field name="is_cm_subscription" string="Is Subscription"/>
                <separator/>
                <filter name="filter_cm_subscriptions" 
                        string="📋 Subscriptions Only" 
                        domain="[('is_cm_subscription', '=', True)]"/>
                <separator/>
                <filter name="filter_paid" 
                        string="✅ Paid" 
                        domain="[('subscription_payment_status', '=', 'paid')]"/>
                <filter name="filter_in_payment" 
                        string="🔵 In Payment" 
                        domain="[('subscription_payment_status', '=', 'in_payment')]"/>
                <filter name="filter_requires_payment" 
                        string="⚠️ Requires Payment" 
                        domain="[('subscription_payment_status', '=', 'requires_payment')]"/>
                <filter name="filter_pending" 
                        string="🟠 Pending Payment" 
                        domain="[('subscription_payment_status', '=', 'pending')]"/>
                <filter name="filter_expired" 
                        string="🔴 Expired" 
                        domain="[('subscription_payment_status', '=', 'expired')]"/>
                <filter name="filter_should_invoice" 
                        string="📝 Should Invoice" 
                        domain="[('subscription_payment_status', '=', 'should_invoice')]"/>
                <filter name="filter_free_status" 
                        string="🎁 Free Status" 
                        domain="[('subscription_payment_status', '=', 'free')]"/>
                <separator/>
                <!-- ===== SHUTDOWN ALERT FILTERS ===== -->
                <filter name="filter_should_shutdown" 
                        string="⚠️ System Should Shutdown" 
                        domain="[('subscription_payment_status', 'in', ['pending', 'expired', 'requires_payment']), ('is_server_shutdown', '=', False)]"/>
                <filter name="filter_already_shutdown" 
                        string="🔴 Server Already Shutdown" 
                        domain="[('is_server_shutdown', '=', True)]"/>
                <separator/>
                <!-- ===== FREE SUBSCRIPTION FILTERS ===== -->
                <filter name="filter_free_subscriptions" 
                        string="🎁 Free Subscriptions" 
                        domain="[('is_free_subscription', '=', True)]"/>
                <filter name="filter_paid_subscriptions" 
                        string="💰 Paid Subs Only" 
                        domain="[('is_free_subscription', '=', False)]"/>
                <filter name="filter_free_expiring" 
                        string="⏰ Free Expiring Soon" 
                        domain="[('is_free_subscription', '=', True), ('free_days_remaining', '&gt;', 0), ('free_days_remaining', '&lt;=', 30)]"/>
                <filter name="filter_free_expired" 
                        string="⚡ Free Period Ended" 
                        domain="[('free_subscription_expired', '=', True)]"/>
                <separator/>
                <filter name="filter_pending_invoice" 
                        string="Has Pending Invoice" 
                        domain="[('has_pending_invoice', '=', True)]"/>
                <filter name="filter_missing_invoice" 
                        string="Missing Invoice" 
                        domain="[('has_missing_invoice', '=', True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_payment_status" 
                            string="Payment Status" 
                            context="{'group_by': 'subscription_payment_status'}"/>
                    <filter name="group_free_reason" 
                            string="Free Reason" 
                            context="{'group_by': 'free_subscription_reason'}"/>
                    <filter name="group_last_payment_partner" 
                            string="Last Paid By" 
                            context="{'group_by': 'last_payment_partner_id'}"/>
                    <filter name="group_is_subscription" 
                            string="Is Subscription" 
                            context="{'group_by': 'is_cm_subscription'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Server action to mark orders as subscriptions -->
    <record id="action_mark_as_subscription" model="ir.actions.server">
        <field name="name">Mark as Subscription</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_mark_as_subscription()</field>
    </record>

    <!-- Server action to unmark subscriptions -->
    <record id="action_unmark_subscription" model="ir.actions.server">
        <field name="name">Remove Subscription Mark</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_unmark_subscription()</field>
    </record>

</odoo>
