        <!-- Default Social Channels with Brand Icons -->
        
        <record id="channel_whatsapp" model="social.channel">
            <field name="name">WhatsApp</field>
            <field name="code">cm_whatsapp</field>
            <field name="channel_type">whatsapp</field>
            <field name="icon">💬</field>
            <field name="color">#25D366</field>
            <field name="sequence">1</field>
            <field name="can_send_text">True</field>
            <field name="can_send_media">True</field>
            <field name="can_receive">True</field>
            <field name="requires_template">True</field>
            <field name="state">connected</field>
            <field name="image_icon" type="base64" file="cm_whatsapp_subscription_sender/static/src/img/whatsapp.svg"/>
        </record>
        
