<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_city_ma_tree" model="ir.ui.view">
        <field name="name">res.city.ma.tree</field>
        <field name="model">res.city.ma</field>
        <field name="arch" type="xml">
            <list string="Villes">
                <field name="name"/>
                <field name="region_id"/>
            </list>
        </field>
    </record>

    <record id="view_res_city_ma_form" model="ir.ui.view">
        <field name="name">res.city.ma.form</field>
        <field name="model">res.city.ma</field>
        <field name="arch" type="xml">
            <form string="Ville">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="region_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_res_city_ma" model="ir.actions.act_window">
        <field name="name">Villes (Maroc)</field>
        <field name="res_model">res.city.ma</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_res_city_ma" name="Villes" parent="menu_ma_regional_access_config" action="action_res_city_ma" sequence="20"/>

</odoo>
